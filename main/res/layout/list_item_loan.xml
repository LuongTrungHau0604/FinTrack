<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/img_loan_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        app:srcCompat="@drawable/ic_loan_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_loan_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Vay mua xe máy"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txt_loan_entity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="FE Credit"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"/>

        <TextView
            android:id="@+id/txt_loan_due_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Due: 2025-01-10"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_loan_remaining_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        tools:text="15,000,000 ₫"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="end"
        android:textColor="?android:attr/textColorPrimary"/>

    <!-- Nút Edit -->
    <ImageButton
        android:id="@+id/btn_edit_loan"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit Loan"/>

    <!-- Nút Delete -->
    <ImageButton
        android:id="@+id/btn_delete_loan"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Loan"/>

</LinearLayout>