<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"> <!-- Nền trong suốt hoặc màu khác -->

    <!-- Ngày trả nợ -->
    <TextView
        android:id="@+id/txt_repayment_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="10 May 2024"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"/>

    <!-- Số tiền đã trả -->
    <TextView
        android:id="@+id/txt_repayment_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        tools:text="- 1,800,000 ₫"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorExpense" /> <!-- Dùng màu chi tiêu -->

    <!-- Optional: Nút để xem chi tiết hoặc xóa lần trả nợ -->
    <!-- <ImageButton ... /> -->

</LinearLayout>