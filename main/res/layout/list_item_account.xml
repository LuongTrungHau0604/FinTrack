<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/img_account_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        tools:srcCompat="@drawable/ic_account_balance_wallet" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Vietcombank (Shared)"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"/>

        <TextView
            android:id="@+id/txt_account_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Bank Account"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_account_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        tools:text="15,000,000 ₫"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="end"
        android:textColor="?android:attr/textColorPrimary"/>

    <!-- Nút Edit -->
    <ImageButton
        android:id="@+id/btn_edit_account"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit Account"
        android:visibility="visible"/> <!-- Sẽ ẩn/hiện trong code nếu là shared account -->

    <!-- Nút Delete / Leave -->
    <ImageButton
        android:id="@+id/btn_delete_account"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_delete"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="Delete or Leave Account"/>

</LinearLayout>